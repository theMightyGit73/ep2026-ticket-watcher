<?xml version="1.0" encoding="UTF-8"?>
<!--
  LaunchAgent for the EP2026 watcher.

  A LaunchAgent, not a LaunchDaemon, and that is not incidental: the watcher
  drives a real visible Chrome window, so it needs a logged-in GUI session.
  A daemon has no window server and the browser would fail to launch.

  Install:
    cp launchd/com.davidcoyne.ep2026watcher.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.davidcoyne.ep2026watcher.plist

  Stop:
    launchctl unload ~/Library/LaunchAgents/com.davidcoyne.ep2026watcher.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.davidcoyne.ep2026watcher</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/davidcoyne/SideProjects/EPTicketRefresher/run_watcher.sh</string>
        <string>watch</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/davidcoyne/SideProjects/EPTicketRefresher</string>

    <key>RunAtLoad</key>
    <true/>

    <!-- Restart on failure, but NOT on a clean exit.

         `watch` is a long-running loop, so if it dies (Chrome crash, network
         drop, a bug) it should come straight back. But it also exits 0 on
         purpose once it passes its stop date, and a plain KeepAlive=true
         would resurrect it within seconds, forever — the watcher would
         announce its own shutdown every minute until someone noticed.

         SuccessfulExit=false means "restart only if it exited unsuccessfully",
         which is what makes the stop date actually stop it. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>60</integer>

    <key>StandardOutPath</key>
    <string>/Users/davidcoyne/.ep2026-watcher/logs/watcher.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/davidcoyne/.ep2026-watcher/logs/watcher.err.log</string>
</dict>
</plist>
